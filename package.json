{
  "name": "company-landing-page",
  "version": "1.0.0",
  "description": "NextWave enterprise company landing page & inquiry board with Cloudflare D1",
  "scripts": {
    "dev": "wrangler pages dev . --d1 DB=company_inquiry_db --port 8788",
